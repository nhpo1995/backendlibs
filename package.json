{
  "name": "backend-service-curriculum",
  "private": true,
  "scripts": {
    "build": "npm run prepare:content && npm run typecheck && vite build && node scripts/package_frontend.cjs",
    "build:editor": "node scripts/build_editor.cjs",
    "test:browser": "playwright test",
    "prepare:content": "python scripts/package_practice.py --lesson-labs-only && python scripts/build_site.py && python scripts/export_react_content.py && node scripts/package_frontend.cjs --stage",
    "dev": "npm run prepare:content && vite",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "test:code-check": "node --test tests/code-comparison.test.mts tests/lesson-exercises.test.mts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.56.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  }
}
